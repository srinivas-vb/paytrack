# Copy to .env at the repo root. .env is gitignored -- never commit real values.

# Render Postgres "External Database URL" (Connections tab in the dashboard).
# Used by the server, and by `npm run db:init` / `npm run db:verify`.
DATABASE_URL=postgres://user:pass@host/dbname

# Gemini key for vision paystub extraction. Lives ONLY on the server -- never
# in the web app, never prefixed with VITE_, never committed. Without it the
# extract endpoint returns 503 and the UI routes to manual entry, which works.
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=...

# Optional. The VISION model, used to read paystub photos. Defaults to
# `gemini-flash-latest`, an alias chosen deliberately: pinned ids deprecate
# (gemini-2.5-flash already 404s for new keys) and this project will not be
# around to notice the next one.
GEMINI_MODEL=gemini-flash-latest

# Optional. The EXPLAINER model -- deliberately a different one.
#
# The free tier meters 20 requests/day PER MODEL, not per key. Verified by
# calling both at the same moment: one returned 429 while the other returned
# 200. Point these two at the same model and they compete for one bucket, and
# the explainer is the one you re-run while rehearsing a demo.
#
# Extraction gets the full-size model because it is the feature that cannot
# degrade -- nothing else can read a photograph. An explanation that never
# renders costs nothing: the figures are already on screen.
GEMINI_EXPLAIN_MODEL=gemini-flash-lite-latest

# Comma-separated allowlist for CORS. Unset => all origins (dev only).
# In production set this to your Render static site URL.
ALLOWED_ORIGINS=https://paytrack-web.onrender.com

PORT=3001
